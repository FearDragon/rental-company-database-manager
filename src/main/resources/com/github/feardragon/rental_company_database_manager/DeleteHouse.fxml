<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" visible="false" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.github.feardragon.rental_company_database_manager.DeleteHouseController">
    <children>
        <Label layoutX="37.0" layoutY="37.0" text="Enter House ID: " />
        <TextField fx:id="idField" layoutX="132.0" layoutY="33.0" prefHeight="25.0" prefWidth="50.0" />
        <Button layoutX="106.0" layoutY="94.0" mnemonicParsing="false" onAction="#deleteHouse" text="Delete" />
        <Label fx:id="deleteHouseSuccess" layoutX="182.0" layoutY="100.0" styleClass="custom-success-message" stylesheets="@styles.css" text="Successfully deleted entry!" visible="false" />
        <Label fx:id="deleteHouseFailed" layoutX="182.0" layoutY="100.0" styleClass="custom-warning-message" stylesheets="@styles.css" text="Failed to delete" visible="false" />
        <Label fx:id="deleteHouseWarning" layoutX="182.0" layoutY="100.0" styleClass="custom-warning-message" stylesheets="@styles.css" text="Please fill in the field" visible="false" />
    </children>
</AnchorPane>
