<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.github.feardragon.rental_company_database_manager.YearlyProfitController">
    <children>
        <Label layoutX="37.0" layoutY="37.0" text="House" />
        <ComboBox fx:id="houseComboBox" layoutX="84.0" layoutY="33.0" prefHeight="25.0" prefWidth="275.0" />
        <Label layoutX="37.0" layoutY="98.0" text="Year" />
        <TextField fx:id="yearField" layoutX="84.0" layoutY="94.0" prefHeight="25.0" prefWidth="75.0" />
        <Button layoutX="84.0" layoutY="172.0" mnemonicParsing="false" onAction="#getYearlyProfit" text="Submit" />
      <Label fx:id="blankWarning" layoutX="171.0" layoutY="176.0" styleClass="custom-warning-message" stylesheets="@styles.css" text="Please fill in all the fields" visible="false" />
      <Label fx:id="profits" layoutX="171.0" layoutY="175.0" text="Profits: $" />
    </children>
</AnchorPane>
