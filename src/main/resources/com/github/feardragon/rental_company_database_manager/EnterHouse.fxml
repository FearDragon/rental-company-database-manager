<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" visible="false" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.github.feardragon.rental_company_database_manager.EnterHouseController">
    <children>
        <Label layoutX="38.0" layoutY="37.0" text="Street Address" />
        <TextField fx:id="housesStreetField" layoutX="134.0" layoutY="33.0" prefHeight="25.0" prefWidth="275.0" />
        <Label layoutX="38.0" layoutY="99.0" text="City" />
        <Label layoutX="272.0" layoutY="99.0" text="County" />
        <TextField fx:id="housesCityField" layoutX="75.0" layoutY="95.0" />
        <TextField fx:id="housesCountyField" layoutX="324.0" layoutY="95.0" />
        <Label layoutX="38.0" layoutY="163.0" text="State" />
        <ComboBox fx:id="housesStateComboBox" layoutX="78.0" layoutY="159.0" prefWidth="150.0" />
        <Label layoutX="272.0" layoutY="163.0" text="Zip Code" />
        <TextField fx:id="zipCodeField" layoutX="335.0" layoutY="159.0" />
        <Label layoutX="37.0" layoutY="219.0" text="First Name" />
        <TextField fx:id="housesFirstNameField" layoutX="116.0" layoutY="215.0" prefHeight="25.0" prefWidth="175.0" />
        <Label layoutX="321.0" layoutY="219.0" text="Last Name" />
        <TextField fx:id="housesLastNameField" layoutX="399.0" layoutY="215.0" prefHeight="25.0" prefWidth="175.0" />
        <Label layoutX="38.0" layoutY="282.0" text="Email" />
        <Label layoutX="38.0" layoutY="342.0" text="Phone Number" />
        <TextField fx:id="housesEmailField" layoutX="86.0" layoutY="278.0" prefHeight="25.0" prefWidth="200.0" />
        <TextField fx:id="housesPhoneField" layoutX="134.0" layoutY="338.0" onAction="#handleHousesPhoneAction" prefHeight="25.0" prefWidth="150.0" />
        <Button layoutX="75.0" layoutY="415.0" mnemonicParsing="false" onAction="#enterHouse" text="Enter" />
        <Label fx:id="enterHouseWarning" layoutX="142.0" layoutY="421.0" styleClass="custom-warning-message" stylesheets="@styles.css" text="Please fill in all the fields" visible="false" />
        <Label fx:id="enterHouseFailed" layoutX="142.0" layoutY="421.0" styleClass="custom-warning-message" stylesheets="@styles.css" text="Failed to enter" visible="false" />
        <Label fx:id="enterHouseSuccess" layoutX="143.0" layoutY="421.0" styleClass="custom-success-message" stylesheets="@styles.css" text="Successfully entered entry!" visible="false" />
        <Label fx:id="enterHouseEmailWarning" layoutX="310.0" layoutY="282.0" styleClass="custom-warning-message" stylesheets="@styles.css" text="Please enter a valid email" visible="false" />
    </children>

</AnchorPane>
