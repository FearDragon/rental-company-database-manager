<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.github.feardragon.rental_company_database_manager.EnterExpenseController"
            prefHeight="400.0" prefWidth="600.0">
    <children>
        <Label layoutX="37.0" layoutY="37.0" text="House" />
        <ComboBox fx:id="expenseHouseComboBox" layoutX="84.0" layoutY="33.0" prefHeight="25.0" prefWidth="275.0" />
        <Label layoutX="37.0" layoutY="99.0" text="Expense Name" />
        <TextField fx:id="expenseNameField" layoutX="147.0" layoutY="95.0" prefHeight="25.0" prefWidth="250.0" />
        <Label layoutX="37.0" layoutY="163.0" text="Expense Price" />
        <Label layoutX="37.0" layoutY="219.0" text="Date" />
        <TextField fx:id="expensePriceField" layoutX="147.0" layoutY="159.0" onAction="#handleExpensePriceAction" prefHeight="25.0" prefWidth="125.0" />
        <DatePicker fx:id="expenseDateField" layoutX="102.0" layoutY="215.0" />
        <Button layoutX="76.0" layoutY="308.0" mnemonicParsing="false" onAction="#enterExpense" text="Enter" />
        <Label fx:id="enterExpenseWarning" layoutX="145.0" layoutY="312.0" styleClass="custom-warning-message" stylesheets="@styles.css" text="Please fill in all the fields" visible="false" />
        <Label fx:id="enterExpenseFailed" layoutX="145.0" layoutY="311.0" styleClass="custom-warning-message" stylesheets="@styles.css" text="Failed to enter" visible="false" />
        <Label fx:id="enterExpenseSuccess" layoutX="145.0" layoutY="309.0" styleClass="custom-success-message" stylesheets="@styles.css" text="Successfully entered entry!" visible="false" />
    </children>
</AnchorPane>
